<?xml version="1.0" encoding="utf-8"?>
<!--
  DoxaizOS — локальный манифест для дерева AOSP/LineageOS.

  Кладётся в <AOSP>/.repo/local_manifests/doxaiz.xml (это делает scripts/build.sh).

  База: LineageOS 24.0 (ветка lineage-24.0). Проверено по официальному
  default.xml репозитория github.com/LineageOS/android: lineage-24.0
  фиксирует AOSP на refs/tags/android-17.0.0_r1 (Android 17).

  Здесь НЕ клонируем этот репозиторий в дерево: overlay применяется копией
  (scripts/apply-overlay.sh), поэтому манифест не зависит от того, в какой
  ветке лежат исходники DoxaizOS.

  Политика удалений — консервативная: убирается только то, что на 100% не
  используется в образе телефона (automotive-пакеты и TV/game-приложения),
  и это ровно те шаги, которые меньше всего рискуют сломать сборку.
  Каждое удаление сверено с default.xml lineage-24.0 на 2026-11-23.
  Дополнительные удаления — по одному, с полной пересборкой после каждого
  (см. комментарии ниже).

  GSI-безопасность: все записи ниже — платформенные automotive/TV-проекты
  (DEVICE-независимый хвост манифеста). Ничего модель-специфичного (device/*,
  vendor/* конкретного устройства) не удаляется — поэтому <remove-project>
  не влияет на GSI-сборку (lunch doxaiz_arm64-userdebug, docs/GSI.md).
-->
<manifest>

  <!-- Automotive (Android Auto/Car): на телефоне не собираются и не нужны.
       Единственная большая «пачка» мёртвого груза в синхронизации AOSP. -->
  <remove-project name="platform/packages/apps/Car/CalendarPrebuilt" />
  <remove-project name="platform/packages/apps/Car/Cluster" />
  <remove-project name="platform/packages/apps/Car/DataSubscriptionReference" />
  <remove-project name="platform/packages/apps/Car/DebuggingRestrictionController" />
  <remove-project name="platform/packages/apps/Car/DialerPrebuilt" />
  <remove-project name="platform/packages/apps/Car/DriverUIPrebuilt" />
  <remove-project name="platform/packages/apps/Car/LatinIME" />
  <remove-project name="platform/packages/apps/Car/Launcher" />
  <remove-project name="platform/packages/apps/Car/LinkViewer" />
  <remove-project name="platform/packages/apps/Car/LocalMediaPlayer" />
  <remove-project name="platform/packages/apps/Car/MediaPrebuilt" />
  <remove-project name="platform/packages/apps/Car/MessengerPrebuilt" />
  <remove-project name="platform/packages/apps/Car/Notification" />
  <remove-project name="platform/packages/apps/Car/Provision" />
  <remove-project name="platform/packages/apps/Car/RadioPrebuilt" />
  <remove-project name="platform/packages/apps/Car/References" />
  <remove-project name="platform/packages/apps/Car/RotaryController" />
  <remove-project name="platform/packages/apps/Car/RotaryImePrebuilt" />
  <remove-project name="platform/packages/apps/Car/SettingsIntelligence" />
  <remove-project name="platform/packages/apps/Car/SystemUpdater" />
  <remove-project name="platform/packages/apps/Car/Templates" />
  <remove-project name="platform/packages/apps/Car/TemplatesPrebuilt" />
  <remove-project name="platform/packages/apps/Car/VoiceControl" />
  <remove-project name="platform/packages/apps/Car/systemlibs" />

  <!-- TV/игровые-приставочные приложения: на телефоне не используются -->
  <remove-project name="platform/packages/apps/VirtualGamepad" />
  <remove-project name="platform/packages/apps/TvFeedbackConsent" />
  <remove-project name="platform/packages/apps/SampleLocationAttribution" />

  <!-- Кандидаты для более агрессивной сборки (включайте по одному,
       после каждого — полная пересборка и запуск на Cuttlefish!):

  <remove-project name="platform/packages/apps/QuickSearchBox" />
  Поиск; у Doxaiz Launcher свой поиск по приложениям.

  <remove-project name="LineageOS/android_packages_apps_Launcher3" />
  Стандартный лаунчер Android. УДАЛЯТЬ ТОЛЬКО после того, как Doxaiz Launcher
  встроен в образ и получает роль HOME (docs/LAUNCHER.md) — иначе у пользователя
  не будет экрана и настройки.

  <remove-project name="platform/packages/apps/Music" />
  AOSP-плеер. Нужен, только если используете его.

  <remove-project name="platform/packages/apps/MusicFX" />
  Аудио-эффекты для AOSP-плеера.

  <remove-project name="platform/packages/apps/Browser2" />
  AOSP-браузер. Удаляйте, если ставите свой (F-Droid/Chromium).

  <remove-project name="platform/packages/apps/HTMLViewer" />
  Просмотр HTML-файлов; Doxaiz Launcher его не использует.
  -->
</manifest>
